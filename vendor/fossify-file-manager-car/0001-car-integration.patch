 package org.fossify.filemanager.extensions
 
 import android.content.Context
+import android.content.res.Configuration
 import android.os.storage.StorageManager
 import org.fossify.commons.extensions.isPathOnOTG
 import org.fossify.commons.extensions.isPathOnSD
 import org.fossify.filemanager.helpers.Config
 import org.fossify.filemanager.helpers.PRIMARY_VOLUME_NAME
 import java.util.Locale
+import kotlin.math.roundToInt
+
+private const val FIXED_UI_SCALE = 1.75f
+
+fun Context.withFixedUiScale(): Context {
+    val currentDensityDpi = resources.configuration.densityDpi
+    if (currentDensityDpi <= 0) return this
+    val scaledConfiguration = Configuration(resources.configuration).apply {
+        densityDpi = (currentDensityDpi * FIXED_UI_SCALE).roundToInt()
+    }
+    return createConfigurationContext(scaledConfiguration)
+}
 
 val Context.config: Config get() = Config.newInstance(applicationContext)
 
