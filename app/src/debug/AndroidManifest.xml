<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name=".debug.NavigationDemoAccessibilityService"
            android:exported="true"
            android:label="@string/navigation_demo_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/navigation_demo_accessibility_service" />
        </service>
    </application>

    <instrumentation
        android:name=".smoke.SmokeInstrumentation"
        android:functionalTest="true"
        android:handleProfiling="false"
        android:label="03桌面 V1 smoke"
        android:targetPackage="com.tcrrry.desktop" />

</manifest>
