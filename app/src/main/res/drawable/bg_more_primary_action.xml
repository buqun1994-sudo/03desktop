<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/more_button_disabled" />
            <corners android:radius="@dimen/icar_control_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/more_button_pressed" />
            <corners android:radius="@dimen/icar_control_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/more_button_surface" />
            <corners android:radius="@dimen/icar_control_radius" />
        </shape>
    </item>
</selector>
