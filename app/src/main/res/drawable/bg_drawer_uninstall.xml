<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/drawer_danger" />
            <corners android:radius="@dimen/drawer_control_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/drawer_surface_elevated" />
            <corners android:radius="@dimen/drawer_control_radius" />
            <stroke
                android:width="1px"
                android:color="@color/drawer_danger" />
        </shape>
    </item>
</selector>
