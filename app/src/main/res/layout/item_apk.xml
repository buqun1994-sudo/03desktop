<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/install_file_row_height"
    android:background="@drawable/bg_install_file_row"
    android:clickable="true"
    android:focusable="true"
    android:foregroundGravity="center_vertical"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/icar_spacing_24"
    android:paddingEnd="@dimen/icar_spacing_18">

    <ImageView
        android:layout_width="@dimen/install_file_icon_size"
        android:layout_height="@dimen/install_file_icon_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_apk_file" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/icar_spacing_18"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/apk_name"
            style="@style/InstallText.FileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/apk_meta"
            style="@style/IcarText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/icar_spacing_12"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/install_file_chevron_size"
        android:layout_height="@dimen/install_file_chevron_size"
        android:layout_marginStart="@dimen/icar_spacing_18"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_install_chevron" />
</LinearLayout>
