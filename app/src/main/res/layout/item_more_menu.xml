<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/more_menu_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/more_item_height"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/icar_spacing_24"
    android:paddingRight="@dimen/icar_spacing_24">

    <ImageView
        android:id="@+id/more_menu_icon"
        android:layout_width="@dimen/more_item_icon_size"
        android:layout_height="@dimen/more_item_icon_size"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/more_menu_label"
        style="@style/IcarText.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/more_item_icon_spacing"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1" />
</LinearLayout>
