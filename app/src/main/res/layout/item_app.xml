<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/drawer_app_item_height"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/drawer_app_item_top_padding"
    tools:ignore="PxUsage">

    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="@dimen/drawer_app_icon_size"
        android:layout_height="@dimen/drawer_app_icon_size"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/app_label"
        style="@style/DrawerText.AppLabel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/drawer_app_label_height"
        android:layout_marginTop="@dimen/drawer_app_label_spacing"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingLeft="@dimen/drawer_app_label_horizontal_padding"
        android:paddingRight="@dimen/drawer_app_label_horizontal_padding" />

</LinearLayout>
